# ---- Database ----
# Local dev default (SQLite file, works out of the box, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) — set this instead once you have a hosted database
# (e.g. Neon, Supabase, Railway, Vercel Postgres) and switch the provider
# in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ---- Auth ----
# Random 32+ char secret used to sign admin session cookies. Generate with:
# openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ---- File storage (optional, for production) ----
# Leave all three blank to use local disk storage (./public/uploads), which
# works immediately but is NOT persistent on most hosting platforms (files
# are wiped on redeploy). For production, create an S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2) and set:
# STORAGE_S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# STORAGE_S3_BUCKET="portfolio-documents"
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# STORAGE_S3_PUBLIC_URL="https://<public-bucket-domain>"

# ---- Email notifications on new contact messages (optional) ----
# Uses Resend (resend.com) if set; otherwise messages are just saved to the DB.
# RESEND_API_KEY=""
# CONTACT_NOTIFY_EMAIL="luqman13743@gmail.com"

NODE_ENV="development"
