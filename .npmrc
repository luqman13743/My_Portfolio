# better-sqlite3 ships prebuilt native binaries for every platform inside
# its npm package (node_modules/better-sqlite3/prebuilds/*.node) — no
# compilation is needed. Without this, npm's default lifecycle still tries
# to run `node-gyp rebuild` for any package containing a binding.gyp file,
# which needs to download Node header files from nodejs.org and fails in
# network-restricted environments (and is slower everywhere else) for no
# reason, since the prebuilt binary is already sitting right there.
ignore-scripts=true
